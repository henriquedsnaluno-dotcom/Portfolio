<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atividade 2 - Exercício 1</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --fundo: #0a0a0a;
            --card-fundo: #121212;
            --borda: #222222;
            --texto-principal: #ffffff;
            --texto-secundario: #888888;
            --verde-neon: #00ff66;
            --verde-glow: rgba(0, 255, 102, 0.15);
        }
        body { background-color: var(--fundo); color: var(--texto-principal); font-family: 'Inter', sans-serif; padding: 40px 20px; }
        .container { max-width: 1000px; margin: 0 auto; }
        .btn-voltar { color: var(--texto-secundario); text-decoration: none; font-size: 0.9rem; display: inline-block; margin-bottom: 30px; transition: color 0.3s; }
        .btn-voltar:hover { color: var(--verde-neon); }
        
        header { margin-bottom: 40px; border-bottom: 1px solid var(--borda); padding-bottom: 20px; }
        header h1 { font-size: 2rem; font-weight: 700; margin-bottom: 5px; }
        header h1 span { color: var(--verde-neon); }

        .layout-projeto { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
        @media (max-width: 768px) { .layout-projeto { grid-template-columns: 1fr; } }

        .codigo-fonte { background-color: var(--card-fundo); border: 1px solid var(--borda); border-radius: 8px; padding: 20px; }
        .codigo-fonte h4 { font-size: 1rem; margin-bottom: 15px; border-bottom: 1px solid var(--borda); padding-bottom: 10px; }
        pre { background-color: #050505; padding: 15px; border-radius: 6px; overflow-x: auto; border: 1px solid #151515; }
        code { font-family: 'Fira Code', monospace; font-size: 0.85rem; color: #d4d4d4; line-height: 1.5; }

        .terminal { background-color: #000000; border: 1px solid var(--borda); border-radius: 8px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); display: flex; flex-direction: column; }
        .terminal-header { font-family: 'Fira Code', monospace; color: #555555; font-size: 0.8rem; margin-bottom: 20px; border-bottom: 1px dashed #1a1a1a; padding-bottom: 8px; }
        .btn-executar { background-color: transparent; border: 1px solid var(--verde-neon); color: var(--verde-neon); padding: 10px 20px; font-family: 'Fira Code', monospace; font-weight: 600; border-radius: 4px; cursor: pointer; transition: all 0.3s; text-align: center; width: fit-content; }
        .btn-executar:hover { background-color: var(--verde-neon); color: #000000; box-shadow: 0 0 15px var(--verde-neon); }
        .output { margin-top: 25px; background-color: #030303; border: 1px solid #111; padding: 15px; border-radius: 6px; font-family: 'Fira Code', monospace; font-size: 0.85rem; color: #a0a0a0; white-space: pre-wrap; min-height: 150px; }
    </style>
</head>
<body>

    <div class="container">
        <a href="../index.html" class="btn-voltar">← Voltar para Exercícios</a>

        <header>
            <h1>Exercício 01<span>.</span></h1>
            <p style="color: var(--texto-secundario);">Declaração e exibição tipada de dados estáticos.</p>
        </header>

        <div class="layout-projeto">
            <div class="codigo-fonte">
                <h4>Código Original (Python)</h4>
                <pre><code># Declaração das variáveis
resistencia_resistor = 47  # em Ohms
numero_fios = 12            # número de fios em um cabo
nome_projeto = "Subestacao Norte"
sistema_energizado = True    # se o sistema está energizado

# Exibindo as variáveis
print("Resistência do resistor:", resistencia_resistor, "Ohms")
print("Número de fios no cabo:", numero_fios)
print("Nome do projeto:", nome_projeto)
print("Sistema energizado:", sistema_energizado)</code></pre>
            </div>

            <div class="terminal">
                <div class="terminal-header">Terminal Interativo - Python Emulator v1.0</div>
                <button class="btn-executar" onclick="rodarExercicio1()">[ Executar Script ]</button>
                <div class="output" id="console_output">Aguardando execução...</div>
            </div>
        </div>
    </div>

    <script>
        function rodarExercicio1() {
            let out = document.getElementById('console_output');
            let res = "Resistência do resistor: 47 Ohms\n";
            res += "Número de fios no cabo: 12\n";
            res += "Nome do projeto: Subestacao Norte\n";
            res += "Sistema energizado: True";
            
            out.textContent = res;
            out.style.color = "var(--verde-neon)";
        }
    </script>
</body>
</html>
